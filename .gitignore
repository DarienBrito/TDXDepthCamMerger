# TouchDesigner autoincrements on every plain save: the master and its numbered
# backups are all regenerated locally, so only the exported .tox is tracked.
# The glob covers the pre-rename TDXDepthCameraMerger files too.
TDXDepthCam*.toe
Backup/TDXDepthCam*.toe
Backup/*.tar.gz
DemoTDXDepthCamMerger.[0-9]*.toe

# build-time log from tools/td_build_demo.py
Log/*.log

__pycache__/
*.pyc
